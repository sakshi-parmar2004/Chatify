# Copy to .env and fill in. The server validates these at boot and exits if any
# required value is missing.

# --- Server ---
PORT=8000
NODE_ENV=development
# Origin of the client, used for CORS and for links in outgoing email
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb://localhost:27017/chatify

# --- Auth ---
# Use a long random string, e.g. `openssl rand -base64 32`
JWT_SECRET=

# Auth cookie SameSite policy: strict | lax | none
# "strict" is correct when the client is served from the same origin as the API.
# Use "none" if the client is on a different domain — it forces Secure, so HTTPS.
COOKIE_SAMESITE=strict

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Chatify

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Security (Arcjet) ---
ARCJET_KEY=
ARCJET_ENV=development
